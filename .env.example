# Public backend domain for Caddy TLS
BACKEND_DOMAIN=api.example.com

# App / retrieval
CHROMA_DIR=/app/chroma_db
TOP_K=4

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=1
SENTENCE_TRANSFORMERS_HOME=/app/models/sentence_transformers

# LLM / RAG
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Valsea batch STT
VALSEA_API_KEY=vl_your_valsea_api_key_here
VALSEA_BASE_URL=https://api.valsea.ai
VALSEA_LANGUAGE=vietnamese

# Valsea realtime STT
VALSEA_REALTIME_URL=wss://api.valsea.ai/v1/realtime

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=vi
